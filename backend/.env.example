# Amadeus API credentials
# Get yours free at https://developers.amadeus.com/ → My Apps → Create new app
# Covers: flights (Flight Offers Search v2) + hotels (Hotel List v1 + Hotel Offers Search v3 + Hotel Sentiments v2)
# Leave blank to use built-in mock data for all endpoints (no API calls made).
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here

# Set to "production" when you have production-tier credentials.
# Defaults to "test" (free sandbox — real search results, no actual ticketing).
AMADEUS_ENV=test

# Car rental: Amadeus car rental is enterprise-tier only (not in the free sandbox).
# To get real car data, wire up one of these instead:
#   • Rentalcars Connect API — https://www.rentalcarsconnect.com (partner agreement needed)
#   • RapidAPI "Booking.com" car search — https://rapidapi.com/ntd119/api/booking-com18
# RAPIDAPI_KEY=your_rapidapi_key_here

# JWT signing secret (change in production)
JWT_SECRET=geoflow-dev-secret
